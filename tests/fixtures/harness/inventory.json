{
  "version": 1,
  "source": "docs/development/harness-fixtures.md",
  "purposes": {
    "session-record": {
      "summary": "セッションの開始・再開・圧縮を記録し、再開用の要約を渡す",
      "source": "docs/spec/vouch-decision-record.html#s11"
    },
    "review-record": {
      "summary": "明示入力から gate.opened / intent.approved を記録する",
      "source": "docs/development/intent-review.md"
    },
    "artifact-guard": {
      "summary": "approved への無断変更、監査ログの手編集、テストの削除・改変を遮る",
      "source": "docs/spec/vouch-decision-record.html#s11"
    },
    "command-guard": {
      "summary": "main への push と、契約 → テスト → 実装の順序に反するコミットを遮る",
      "source": "docs/spec/vouch-decision-record.html#s11"
    },
    "artifact-check": {
      "summary": "成果物の参照元と判断依頼の欄を書き込み後に検査する",
      "source": "docs/spec/vouch-decision-record.html#s11"
    },
    "command-record": {
      "summary": "DoD コマンドの実行結果を記録する",
      "source": "docs/spec/vouch-decision-record.html#s11"
    },
    "question-record": {
      "summary": "構造化質問の形式を検査し、質問と回答を記録する",
      "source": "docs/spec/vouch-decision-record.html#s10"
    },
    "agent-record": {
      "summary": "reviewer と脇質問のエージェントの依頼と完了を記録する",
      "source": "core/registry/audit-events.json"
    },
    "turn-end": {
      "summary": "ターン終了時に検査・記録する",
      "source": "docs/spec/vouch-decision-record.html#s15"
    }
  },

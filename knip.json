{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "core/hooks/*.mjs",
    "harness/*/manifest.mjs",
    "scripts/*.mjs",
    "tests/**/*.test.mjs",
    "tests/helpers/no-network.mjs",
    "tests/helpers/fixed-clock.mjs",
    "tests/helpers/module-probe.mjs",
    "tests/helpers/load-worker.mjs"
  ],
  "project": [
    "core/**/*.mjs",
    "harness/**/*.mjs",
    "scripts/**/*.mjs",
    "tests/**/*.mjs",
    "*.config.mjs"
  ],
  "ignore": [
    "tests/fixtures/**",
    "tests/golden/**",
    "tests/eval/**",
    "docs/**",
    "dist/**",
    "core/hooks/lib/contracts.mjs",
    "core/hooks/lib/migration-contracts.mjs",
    "core/hooks/lib/runtime-contracts.mjs"
  ],
  "ignoreDependencies": ["@stryker-mutator/command-runner"],
  "ignoreBinaries": ["script"]
}

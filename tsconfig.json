{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["core/**/*.mts", "harness/**/*.mts", "scripts/**/*.mts"],
  "exclude": [
    "node_modules",
    "dist",
    "docs",
    "coverage",
    "reports",
    ".stryker-tmp"
  ]
}

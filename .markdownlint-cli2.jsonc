{
  "globs": [
    "*.md",
    "core/**/*.md",
    "harness/**/*.md",
    "tests/**/*.md",
    "docs/development/**/*.md"
  ],
  "ignores": [
    "tests/fixtures/**",
    "tests/golden/**",
    "harness/claude/CLAUDE.md"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false
  }
}

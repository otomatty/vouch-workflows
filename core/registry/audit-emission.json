{
  "version": 1,
  "storage": "vouch/intents/<intent>/audit/events.jsonl",
  "driver": "core/hooks/lib/io.mjs",
  "store_tests": ["tests/unit/lib/audit.test.mjs"],
  "operations": [
    "intent-created",
    "intent-completed",
    "stage-started",
    "stage-completed",
    "unit-started",
    "unit-completed",
    "gate-approved",
    "gate-rejected",
    "review-requested",
    "review-completed",
    "learn-recorded",
    "session-ended"
  ],
  "events": {
    "intent.created": {
      "fires_when": "vouch-lifecycle intent-created reads the plan's highest risk",
      "input": { "class": "command" },
      "hook": "hooks/vouch-lifecycle.mjs",
      "operation": "intent-created",
      "tests": {
        "positive": "tests/hooks/vouch-lifecycle.test.mjs",
        "negative": "tests/hooks/vouch-lifecycle.test.mjs",
        "subprocess": "tests/hooks/vouch-lifecycle.test.mjs"
      },
      "measures": {
        "parent": null,
        "duration_ms": "absent",
        "wait_ms": "absent",
        "tokens": "omitted"
      }
    },
    "intent.approved": {
      "fires_when": "UserPromptSubmit vouch approve <gate> after a live gate.opened",
      "input": {
        "class": "captured",
        "fixture": "tests/fixtures/harness/claude/2.1.283/linux/print/UserPromptSubmit.json",
        "also": [
          "tests/fixtures/harness/codex/0.153.4/linux/exec/UserPromptSubmit.json"
        ]
      },
      "hook": "hooks/vouch-record-intent-review.mjs",
      "tests": {
        "positive": "tests/hooks/vouch-record-intent-approval.test.mjs",
        "negative": "tests/hooks/vouch-record-intent-review.test.mjs",
        "subprocess": "tests/hooks/vouch-record-intent-approval.test.mjs"
      },
      "measures": {
        "parent": "gate.opened",
        "duration_ms": "absent",
        "wait_ms": "shared-once",
        "tokens": "omitted"
      }
    },
    "intent.completed": {
      "fires_when": "vouch-lifecycle intent-completed sums live waits without a second copy of a shared gate wait",
      "input": { "class": "command" },
      "hook": "hooks/vouch-lifecycle.mjs",
      "operation": "intent-completed",
      "tests": {
        "positive": "tests/hooks/vouch-lifecycle.test.mjs",
        "negative": "tests/hooks/vouch-lifecycle.test.mjs",
        "subprocess": "tests/hooks/vouch-lifecycle.test.mjs"
      },
      "measures": {
        "parent": "intent.created",
        "duration_ms": "parent-clock",
        "wait_ms": "absent",
        "tokens": "omitted"
      }
    },
    "stage.started": {
      "fires_when": "vouch-lifecycle stage-started <stage>",

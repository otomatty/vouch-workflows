{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vouch.dev/schemas/doctor-report.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "ok", "checks"],
  "properties": {
    "v": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ok", "detail"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:DOCTOR|DOD)-[A-Z]+$"
          },
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vouch.dev/schemas/doctor-report.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "ok", "checks"],
  "properties": {
    "v": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ok", "detail"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:DOCTOR|DOD|QUESTION|REPORT)-[A-Z]+$"
          },
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "path",
        "events",
        "invalid",
        "duplicates",
        "types",
        "unpaired"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "duplicates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "types": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["count", "synthetic", "measures"],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "synthetic": {
                "type": "integer",
                "minimum": 0
              },
              "measures": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["n", "sum", "min", "max", "missing", "examples"],
                  "properties": {
                    "n": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sum": {
                      "type": "number"
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "missing": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "examples": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "unpaired": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vouch.dev/schemas/hook-process.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "exitCode": {
          "const": 0
        },
        "stdout": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "stderr": {
          "type": "string"
        }
      },
      "required": ["exitCode", "stdout", "stderr"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "exitCode": {
          "const": 2
        },
        "stdout": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "stderr": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["exitCode", "stdout", "stderr"],
      "additionalProperties": false
    }
  ]
}

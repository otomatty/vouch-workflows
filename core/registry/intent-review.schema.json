{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vouch.dev/schemas/intent-review.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "open": {
      "const": "vouch review"
    },
    "approvePrefix": {
      "const": "vouch approve "
    },
    "gatePattern": {
      "const": "^evt_[a-f0-9]{64}(?![\\s\\S])"
    },
    "confirmPrefix": {
      "const": "vouch confirm "
    },
    "targetPattern": {
      "const": "^(?:(acceptance|scope|units|design)|unit ([A-Za-z0-9][A-Za-z0-9._-]{0,63})|section ([a-z][a-z-]{0,63})|design unit ([A-Za-z0-9][A-Za-z0-9._-]{0,63})|design section ([a-z][a-z-]{0,63}))(?![\\s\\S])"
    },
    "migrateApprovePrefix": {
      "const": "vouch migrate approve "
    },
    "migrateDigestPattern": {
      "const": "^[a-f0-9]{64}(?![\\s\\S])"
    }
  },
  "required": [
    "version",
    "open",
    "approvePrefix",
    "gatePattern",
    "confirmPrefix",
    "targetPattern",
    "migrateApprovePrefix",
    "migrateDigestPattern"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vouch.dev/schemas/hook-result.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "decision": {
          "const": "allow"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "https://vouch.dev/schemas/audit-event.json"
          }
        },
        "context": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["decision"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "decision": {
          "const": "deny"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "https://vouch.dev/schemas/audit-event.json"
          }
        },
        "approve": {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            }
          },
          "required": ["sha256"],
          "additionalProperties": false
        }
      },
      "required": ["decision", "reason"],
      "additionalProperties": false
    }
  ]
}

{
  "version": 1,
  "ask": {
    "prefixes": ["/vouch ask ", "$vouch ask "],
    "questionChars": 2000,
    "answerChars": 4000
  },
  "answer": {
    "prefix": "vouch answer ",
    "pattern": "^(Q-[1-9]\\d{0,5}) ([A-Z])(?![\\s\\S])"
  },
  "question": {
    "operations": ["ask", "default"],
    "pattern": "^Q-[1-9]\\d{0,5}$"
  },
  "resume": {
    "sources": {
      "claude": ["startup", "resume", "clear", "compact"],
      "codex": ["startup", "resume"]
    },
    "items": 8
  },
  "statusline": {
    "chars": 160
  },
  "report": {
    "common_measures": ["tokens.in", "tokens.out"],
    "examples": 3
  },
  "labels": {

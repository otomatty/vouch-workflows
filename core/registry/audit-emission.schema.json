{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vouch.dev/schemas/audit-emission.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "storage",
    "driver",
    "store_tests",
    "operations",
    "events"
  ],
  "properties": {
    "version": { "const": 1 },
    "storage": { "type": "string", "minLength": 1 },
    "driver": { "const": "core/hooks/lib/io.mjs" },
    "store_tests": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fires_when", "input", "hook", "tests", "measures"],
        "properties": {
          "fires_when": { "type": "string", "minLength": 1 },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class"],
            "properties": {
              "class": { "enum": ["captured", "command"] },
              "fixture": { "type": "string", "minLength": 1 },
              "also": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            }
          },
          "hook": {
            "type": "string",
            "pattern": "^hooks/vouch-[a-z-]+\\.mjs$"
          },
          "operation": { "type": "string", "minLength": 1 },
          "migration": {
            "type": "string",
            "pattern": "^hooks/vouch-[a-z-]+\\.mjs$"
          },
          "tests": {
            "type": "object",
            "additionalProperties": false,
            "required": ["positive", "negative", "subprocess"],
            "properties": {
              "positive": { "type": "string", "minLength": 1 },
              "negative": { "type": "string", "minLength": 1 },
              "subprocess": { "type": "string", "minLength": 1 }
            }
          },
          "measures": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parent", "duration_ms", "wait_ms", "tokens"],
            "properties": {
              "parent": { "type": ["string", "null"] },
              "duration_ms": {
                "enum": [
                  "absent",
                  "parent-clock",
                  "restore-clock",
                  "self-clock"
                ]
              },
              "wait_ms": { "enum": ["absent", "parent-clock", "shared-once"] },
              "tokens": { "enum": ["claude-observed", "omitted"] }
            }
          }
        }
      }
    }
  }
}

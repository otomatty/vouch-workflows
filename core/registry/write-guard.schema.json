{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vouch.dev/schemas/write-guard.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tools",
    "intents",
    "audit",
    "artifacts",
    "lockSuffix",
    "installation",
    "shell"
  ],
  "$defs": {
    "names": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z_]+$" },
      "additionalProperties": {
        "enum": ["write", "edit", "patch", "shell"]
      }
    }
  },
  "properties": {
    "$schema": { "const": "./write-guard.schema.json" },
    "version": { "const": 1 },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude", "codex"],
      "properties": {
        "claude": { "$ref": "#/$defs/tools" },
        "codex": { "$ref": "#/$defs/tools" }
      }
    },
    "intents": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z]+$" },
      "minItems": 1
    },
    "audit": { "type": "string", "pattern": "^[a-z]+$" },
    "artifacts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z-]+\\.md$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "lockSuffix": { "const": ".vouch-lock" },
    "installation": { "$ref": "#/$defs/names" },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readers", "refused", "git", "removers"],
      "properties": {
        "readers": { "$ref": "#/$defs/names" },
        "refused": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/names" }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["globals", "commands"],
          "properties": {
            "globals": { "$ref": "#/$defs/names" },
            "commands": { "$ref": "#/$defs/names" }
          }
        },
        "removers": { "$ref": "#/$defs/names" }
      }
    }
  }
}
